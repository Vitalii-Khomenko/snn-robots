+# The body (docs/BODY.md step 3, 2026-10-27): the analyzer's dataset hardly has a tired day or a low body budget (the
+# synthetic stamina sat near 1, the battery runs low in 30 % of the lives only). A share of the synthetic lives gets a
+# felt tiredness by day (the tired channel at least TIRED_LO..HI) or a low budget (hunger at least HUNGER_LO..HI), so
+# the network sees the drives it has to answer.
+BODY_SHARE, TIRED_LO, TIRED_HI, HUNGER_LO, HUNGER_HI = 0.2, 0.15, 0.55, 0.3, 0.85
+
+
+def body_variety(X, real, rng):
+    from spec_v4 import SNN_IN
+    ti, hi = SNN_IN.index("tired"), SNN_IN.index("hunger")
+    X = X.copy()
+    for n in np.flatnonzero(~real):
+        u = rng.random()
+        if u < BODY_SHARE:
+            X[n, :, ti] = np.maximum(X[n, :, ti], rng.uniform(TIRED_LO, TIRED_HI))
+        elif u < 2 * BODY_SHARE:
+            X[n, :, hi] = np.maximum(X[n, :, hi], rng.uniform(HUNGER_LO, HUNGER_HI))
+    return X
+
+
 def build():
     d = np.load(os.path.join(OUT, "snn_data.npz"))
-    X = d["X"]
+    X = body_variety(d["X"], d["real"], np.random.default_rng(27))
     dev = "cuda" if torch.cuda.is_available() else "cpu"
     m = SnnV4().to(dev)
     m.load_state_dict(torch.load(os.path.join(DATA, "snn_v4.pt"), weights_only=False)["state"])
