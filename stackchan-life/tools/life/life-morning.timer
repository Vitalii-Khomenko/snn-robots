# Every morning at 07:00 (or at the next start of the PC if it was off):
#   cp tools/life/life-morning.* ~/.config/systemd/user/ && systemctl --user enable --now life-morning.timer
[Unit]
Description=StackChan morning report at 07:00

[Timer]
OnCalendar=*-*-* 07:00:00
Persistent=true

[Install]
WantedBy=timers.target
