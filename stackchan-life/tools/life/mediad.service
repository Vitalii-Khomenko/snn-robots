# The robot's frames and sound for the perception networks' training (tools/life/mediad.py):
#   cp tools/life/mediad.service ~/.config/systemd/user/ && systemctl --user enable --now mediad
[Unit]
Description=StackChan media takes (frames and sound to the home PC)
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/Codex/StackChan/stackchan-life/tools/life/mediad.py
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
